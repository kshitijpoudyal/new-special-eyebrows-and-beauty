rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Replace with the email(s) of your admin login(s) created in
    // Firebase console → Authentication → Users.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['admin@eyebrows.com'];
    }

    // Service menu, reward rules & booking settings: anyone can read (public site), only admins edit.
    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Booking requests contain personal info: anyone may *submit* a pending
    // request (validated below), only admins can read, accept or reject.
    match /appointments/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || validNewAppointment(request.resource.data);
    }
    function validNewAppointment(d) {
      return d.keys().hasOnly(['name', 'phone', 'email', 'notes', 'services', 'total', 'duration',
                               'date', 'startIdx', 'slotCount', 'timeLabel', 'slotIds', 'status', 'createdAt'])
        && d.status == 'pending'
        && d.createdAt == request.time
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.phone is string && d.phone.size() >= 7 && d.phone.size() <= 30
        && (d.email == null || (d.email is string && d.email.size() <= 200))
        && d.notes is string && d.notes.size() <= 1000
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.startIdx is int && d.slotCount is int
        && d.services is list && d.services.size() >= 1 && d.services.size() <= 30
        && d.slotIds is list && d.slotIds.size() >= 1 && d.slotIds.size() <= 20;
    }

    // Booked time blocks: public (no personal info) so the calendar can show
    // taken times. A visitor can only create one together with the pending
    // appointment that lists it; existing blocks can't be overwritten.
    match /slots/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['date', 'idx', 'seat', 'appt'])
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appt)).data.status == 'pending'
        && id in getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appt)).data.slotIds
      );
      allow update, delete: if isAdmin();
    }

    // Rewards members contain personal info: admins only.
    match /members/{id} {
      allow read, write: if isAdmin();
      match /history/{entry} {
        allow read, write: if isAdmin();
      }
    }
  }
}
