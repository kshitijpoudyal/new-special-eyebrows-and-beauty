rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Replace with the email(s) of your admin login(s) created in
    // Firebase console → Authentication → Users.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['admin@example.com'];
    }

    // Service menu & reward rules: anyone can read (public site), only admins edit.
    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Rewards members contain personal info: admins only.
    match /members/{id} {
      allow read, write: if isAdmin();
      match /history/{entry} {
        allow read, write: if isAdmin();
      }
    }
  }
}
